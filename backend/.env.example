# RobotControl Backend Configuration
# Copy this file to .env and update the values for your environment

# Database Configuration
VM_SQL_SERVER=192.168.3.21,50131
VM_SQL_USER=Hamilton
VM_SQL_PASSWORD=mkdpw:V43

# Backup folder (default: data/backups under the app root). SQL Server writes the
# .bak to this same path, so only change it to a folder SQL Server sees by the same name.
# LOCAL_BACKUP_PATH=data/backups

# Server Settings
# Optional development settings to start the UI without automatic jobs/recording:
# ROBOTCONTROL_SCHEDULER_AUTOSTART_DELAY_SECONDS=disable
# ROBOTCONTROL_AUTO_RECORDING_ENABLED=0
PORT=8005
ROBOTCONTROL_SERVE_FRONTEND=1
DEBUG=True

# Security (change in production)
SECRET_KEY=robotcontrol-simplified-secret-key-2025
