{
  "name": "robotcontrol-simplified-frontend",
  "version": "0.1.5",
  "description": "Simplified React frontend for RobotControl",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "axios": "^1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^25.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "^5.3.2",
    "vite": "^5.0.5",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host 0.0.0.0 --port 3005",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "bundle-analyze": "tsc && vite build --mode analyze && start dist/bundle-analysis.html"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
